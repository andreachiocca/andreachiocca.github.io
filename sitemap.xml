---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign documents = site.pages | concat: site.documents | sort: 'url' %}
{% assign previous_url = '' %}
{% for document in documents %}
  {% assign canonical_path = document.url | replace: 'index.html', '' %}
  {% assign suffix = canonical_path | slice: -1 %}
  {% if document.sitemap != false and canonical_path != previous_url %}
    {% if suffix == '/' or canonical_path contains '.html' %}
  <url><loc>{{ canonical_path | absolute_url | xml_escape }}</loc></url>
      {% assign previous_url = canonical_path %}
    {% endif %}
  {% endif %}
{% endfor %}
</urlset>
