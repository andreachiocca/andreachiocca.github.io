---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign documents = site.pages | concat: site.documents | sort: 'url' %}
{% assign previous_url = '' %}
{% for document in documents %}
  {% assign suffix = document.url | slice: -1 %}
  {% if document.sitemap != false and document.url != previous_url %}
    {% if suffix == '/' or document.url contains '.html' %}
  <url><loc>{{ document.url | absolute_url | xml_escape }}</loc></url>
      {% assign previous_url = document.url %}
    {% endif %}
  {% endif %}
{% endfor %}
</urlset>
